# Copy to `deploy/.env` next to docker-compose.yml, then:
#
#   cp .env.example .env
#   chmod 600 .env          # only the deploying user may read it
#
# Generate a token per line (64 hex characters, well above the 32-character
# minimum the server enforces):
#
#   openssl rand -hex 32
#
# The two tokens MUST be different: the server refuses to start when they are
# equal, because the whole point of the split is that a stolen work-PC token
# cannot be used against the MCP endpoints.
#
# Never commit this file. `.gitignore` and `.dockerignore` both exclude it, so it
# is read from disk at container start and never baked into an image.

# Authenticates the work PC's tunnel (`upgrade /tunnel`). Give this one to the
# work PC only — it goes in the client's config as ${env:MCP_PROXY_CLIENT_TOKEN}.
MCP_PROXY_CLIENT_TOKEN=

# Authenticates Warren itself (`/mcp/<name>`, `/status`). This one never leaves
# the server host and Warren's own configuration.
MCP_PROXY_ENDPOINT_TOKEN=

# Only needed when the Caddy TLS label in docker-compose.yml uses the DNS-01
# challenge: the API token Caddy reads from this container's environment.
# Delete the line if you use an HTTP-01 challenge instead.
# IONOS_TOKEN=

# Optional server knobs (defaults shown; see src/server/config.ts).
# MCP_PROXY_PORT=8080
# MCP_PROXY_HOST=0.0.0.0
# MCP_PROXY_LOG_LEVEL=info
# MCP_PROXY_HEARTBEAT_INTERVAL_MS=15000
# MCP_PROXY_HEARTBEAT_TIMEOUT_MS=30000
# MCP_PROXY_REQUEST_TIMEOUT_MS=300000
# MCP_PROXY_MAX_MESSAGE_BYTES=33554432
# MCP_PROXY_SESSION_IDLE_TTL_MS=604800000
