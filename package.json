{
  "name": "mcp-websocket-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Expose MCP servers on a remote work PC to Warren over an outbound WebSocket tunnel",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:client": "tsx watch --clear-screen=false src/client/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server-filesystem": "2.3.0",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
